# Rollenspezifische Einstellungen – unterscheidet sich (neben config.yaml, CLAUDE.md, role.sh,
# managed-mcp.json) je Rolle.
ROLE=architekt
SESSION_NAME="Architekt"
# Max. gleichzeitige Sitzungen des Remote-Control-Servers (RAM! Builds brauchen mehr als Chat)
CAPACITY=3
# Kein Zugang zu Home Assistant
KEEP_HA_TOKEN=0
# Coding-Agent (Code und Bauthemen in den Repos): Bash ist erlaubt (bewusste Ausnahme, siehe docs/architektur.md "Architekt").
# run.sh verlangt dafuer abgeschaltete claude.ai-Connectoren in den Managed Settings.
BASH_ERLAUBT=1
# Firewall: Internet frei, lokale Netze und IPv6 gesperrt (firewall.sh)
EGRESS=internet
# Wird bei EGRESS=internet nur fuer das Set allow4 genutzt
ALLOW_DOMAINS="anthropic.com claude.ai claude.com"
ALLOW_INTERNAL=""
# Arbeitsordner, persistent (Klone ueberstehen Updates). root-eigen mit Sticky-Bit: der Agent legt
# Repos als Unterordner an, CLAUDE.md/.claude/.mcp.json im Ordner selbst bleiben unveraenderbar.
# Der Ordnername erscheint in der Claude-App und unterscheidet die Agenten.
WORKSPACE=/data/architekt
WORKSPACE_MODE=1775
# Selbst geladene Werkzeuge (Flutter, Android-SDK, JDK, npm -g), persistent, nicht im Backup
TOOLS_DIR=/data/architekt/.werkzeuge
# GitHub-Proxy (rootfs/opt/github-proxy), nur auf 127.0.0.1
PROXY_PORT=8099
BRANCH_PREFIX=claude/
