{
  "permissions": {
    "deny": [
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Drive",
      "mcp__claude_ai_Google_Calendar",
      "Read(//data/claude/**)",
      "Edit(//data/claude/**)",
      "Read(//run/github-proxy/**)",
      "Edit(//data/architekt/.claude/**)",
      "Edit(//data/architekt/.mcp.json)",
      "Edit(//data/architekt/CLAUDE.md)"
    ],
    "allow": [
      "Bash",
      "WebFetch",
      "WebSearch",
      "Edit(//data/architekt/**)",
      "Edit(//tmp/**)",
      "Edit(//home/agent/**)",
      "mcp__ablage__paket_erstellen",
      "mcp__ablage__paket_hochladen"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "allowManagedHooksOnly": true,
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "GIT_TERMINAL_PROMPT": "0"
  }
}
