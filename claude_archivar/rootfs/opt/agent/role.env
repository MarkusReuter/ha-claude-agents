# Rollenspezifische Einstellungen – unterscheidet sich (neben config.yaml, CLAUDE.md, role.sh,
# managed-mcp.json) je Rolle.
ROLE=archivar
SESSION_NAME="Archivar"
# Max. gleichzeitige Sitzungen des Remote-Control-Servers (RAM!)
CAPACITY=2
# Kein Zugang zu Home Assistant
KEEP_HA_TOKEN=0
# Erlaubte Domains inkl. aller Subdomains (TCP 443)
ALLOW_DOMAINS="anthropic.com claude.ai claude.com"
# Interne Ziele als host:port – Paperless kommt aus der Option paperless_url (role.sh)
ALLOW_INTERNAL=""
# Arbeitsordner ausserhalb von /data: heruntergeladene Originale sollen nicht ins HA-Backup,
# und Read laesst sich so fuer ganz /data sperren (dort liegen Login und Paperless-Token).
# 0755 root-eigen: der Agent schreibt nur in $OCR_DIR.
WORKSPACE=/work
WORKSPACE_MODE=0755
OCR_DIR=/work/ocr
