    "deny": [
      "Bash",
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Drive",
      "mcp__claude_ai_Google_Calendar",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "Read(//bin/**)",
      "Read(//boot/**)",
      "Read(//data/**)",
      "Read(//dev/**)",
      "Read(//etc/**)",
      "Read(//home/**)",
      "Read(//lib/**)",
      "Read(//lib64/**)",
      "Read(//media/**)",
      "Read(//mnt/**)",
      "Read(//opt/**)",
      "Read(//proc/**)",
      "Read(//root/**)",
      "Read(//run/**)",
      "Read(//sbin/**)",
      "Read(//srv/**)",
      "Read(//sys/**)",
      "Read(//tmp/**)",
      "Read(//usr/**)",
      "Read(//var/**)",
      "Read(//archivar/.claude/**)",
      "Read(//archivar/.mcp.json)",
      "Edit(//bin/**)",
      "Edit(//boot/**)",
      "Edit(//data/**)",
      "Edit(//dev/**)",
      "Edit(//etc/**)",
      "Edit(//home/**)",
      "Edit(//lib/**)",
      "Edit(//lib64/**)",
      "Edit(//media/**)",
      "Edit(//mnt/**)",
      "Edit(//opt/**)",
      "Edit(//proc/**)",
      "Edit(//root/**)",
      "Edit(//run/**)",
      "Edit(//sbin/**)",
      "Edit(//srv/**)",
      "Edit(//sys/**)",
      "Edit(//tmp/**)",
      "Edit(//usr/**)",
      "Edit(//var/**)",
      "Edit(//archivar/.claude/**)",
      "Edit(//archivar/.mcp.json)",
      "Edit(//archivar/CLAUDE.md)"
    ],
    "ask": [
      "mcp__paperless__update_content",
      "mcp__paperless__set_ocr_tags"
    ],
    "allow": [
      "mcp__paperless__search_documents",
      "mcp__paperless__list_documents_by_tag",
      "mcp__paperless__get_document",
      "mcp__paperless__download_original",
      "mcp__paperless__find_suspicious_ocr",
      "Read(//archivar/ocr/**)",
      "Read(//archivar/CLAUDE.md)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "allowManagedHooksOnly": true,
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  }
}
