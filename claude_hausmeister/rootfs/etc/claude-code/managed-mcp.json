{
  "mcpServers": {
    "homeassistant": {
      "type": "stdio",
      "command": "/usr/local/bin/node",
      "args": ["/opt/agent-mcp/homeassistant.mjs"],
      "env": {
        "HA_URL": "${HA_URL}",
        "HA_TOKEN": "${HA_TOKEN}",
        "HA_WRITE": "${HA_WRITE:-0}",
        "HA_FILES_DIR": "/data/workspace/ha"
      }
    }
  }
}
