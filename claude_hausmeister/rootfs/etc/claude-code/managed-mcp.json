{
  "mcpServers": {
    "homeassistant": {
      "type": "stdio",
      "command": "/usr/local/bin/node",
      "args": ["/opt/ha-mcp/dist/stdio.js"],
      "env": {
        "HA_MCP_URL": "${HA_URL}",
        "HA_MCP_TOKEN": "${HA_TOKEN}",
        "HA_MCP_TZ": "${TZ:-Europe/Berlin}"
      }
    }
  }
}
