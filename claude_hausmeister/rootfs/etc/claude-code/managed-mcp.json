{
  "mcpServers": {
    "homeassistant": {
      "type": "stdio",
      "command": "/usr/local/bin/node",
      "args": ["/opt/agent-mcp/homeassistant.mjs"],
      "env": {
        "HA_URL": "${HA_URL}",
        "HA_TOKEN": "${HA_TOKEN}",
        "HA_WRITE": "${HA_WRITE:-0}",
        "HA_FILES_DIR": "/data/hausmeister/ha"
      }
    },
    "ablage": {
      "type": "stdio",
      "command": "/usr/local/bin/node",
      "args": ["/opt/agent-mcp/ablage.mjs"],
      "env": {
        "ABLAGE_ROOT": "/data/hausmeister",
        "ABLAGE_QUELLEN": "ha ausgang",
        "ABLAGE_ZIEL": "ausgang",
        "ABLAGE_ROLLE": "Hausmeister",
        "ABLAGE_MAX_MB": "25",
        "ABLAGE_GITHUB_REPO": "${ABLAGE_GITHUB_REPO:-}",
        "ABLAGE_GITHUB_TOKEN": "${ABLAGE_GITHUB_TOKEN:-}",
        "ABLAGE_HALTEN_TAGE": "30"
      }
    }
  }
}
