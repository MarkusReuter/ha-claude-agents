# Rollenspezifische Einstellungen – unterscheidet sich (neben config.yaml, CLAUDE.md, role.sh,
# managed-mcp.json) je Rolle.
ROLE=hausmeister
SESSION_NAME="Hausmeister"
# Max. gleichzeitige Sitzungen des Remote-Control-Servers (RAM!)
CAPACITY=3
# 1 = Supervisor-Token als HA_TOKEN an den Agenten durchreichen (nur Hausmeister!)
KEEP_HA_TOKEN=1
# Erlaubte Domains inkl. aller Subdomains (TCP 443)
ALLOW_DOMAINS="anthropic.com claude.ai claude.com"
# Interne Ziele als host:port (Supervisor-Proxy zu HA Core)
ALLOW_INTERNAL="supervisor:80"
# Arbeitsordner (Projektordner von Claude Code) und seine Rechte: 1775 = root-eigen mit
# Sticky-Bit, der Agent darf dort Notizen anlegen, aber CLAUDE.md/.claude/.mcp.json nicht aendern
WORKSPACE=/data/workspace
WORKSPACE_MODE=1775
