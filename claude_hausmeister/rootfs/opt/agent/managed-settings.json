{
  "permissions": {
    "deny": [
      "Bash",
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Drive",
      "mcp__claude_ai_Google_Calendar",
      "WebFetch",
      "WebSearch",
      "Read(//data/claude/**)",
      "Edit(//data/claude/**)",
      "Read(//proc/**)",
      "Edit(//etc/**)",
      "Edit(//opt/**)",
      "Edit(//usr/**)",
      "Edit(//home/**)",
      "Edit(//data/hausmeister/.claude/**)",
      "Edit(//data/hausmeister/.mcp.json)",
      "Edit(//data/hausmeister/CLAUDE.md)",
      "Edit(//data/hausmeister/ha/backup/**)"
    ],
    "ask": [
      "mcp__homeassistant__ha_write",
      "mcp__ablage__paket_hochladen"
    ],
    "allow": [
      "mcp__homeassistant__ha_read",
      "Edit(//data/hausmeister/ha/**)",
      "mcp__ablage__paket_erstellen",
      "Edit(//data/hausmeister/ausgang/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "allowManagedHooksOnly": true,
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  }
}
